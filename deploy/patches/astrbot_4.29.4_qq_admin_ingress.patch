     async def convert_message(self, event: Event) -> AstrBotMessage | None:
+        # FishHome: discard unrelated QQ events before logging or conversion.
+        if (
+            event.get("post_type") != "message"
+            or event.get("message_type") != "private"
+            or event.get("sub_type") != "friend"
+        ):
+            return None
+
+        admins = [str(admin).strip() for admin in astrbot_config.get("admins_id") or []]
+        # AstrBot also uses this list for its built-in WebChat administrator.
+        qq_admins = [admin for admin in admins if admin.isascii() and admin.isdecimal()]
+        sender = event.get("sender")
+        if len(qq_admins) != 1 or not isinstance(sender, dict):
+            return None
+
+        admin_id = qq_admins[0]
+        if (
+            str(event.get("user_id", "")) != admin_id
+            or str(sender.get("user_id", "")) != admin_id
+        ):
+            return None
+
